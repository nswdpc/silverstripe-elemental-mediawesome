{
    "name": "nswdpc/silverstripe-elemental-mediawesome",
    "description": "Element to show mediawesome content.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "nsw",
        "module",
        "mediawesome"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Mark Taylor"
        },
        {
            "name": "James Ellis"
        }
    ],
    "require": {
        "nglasl/silverstripe-mediawesome": "^5",
        "dnadesign/silverstripe-elemental": "^5",
        "nswdpc/silverstripe-grid-helpers": "^1"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "cambis/silverstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2",
        "nswdpc/ci-files": "dev-v-4"
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\Elemental\\Models\\Mediawesome\\Tests\\": [
                "tests/"
            ],
            "NSWDPC\\Elemental\\Models\\Mediawesome\\": [
                "src/Models/Elements/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
